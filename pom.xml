<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.rapidkl</groupId>
    <artifactId>rapidkl-t250-bus-route-system</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>Rapid KL T250 Bus Route System</name>
    <description>AMCS2034 assignment: the Rapid KL feeder route T250 (LRT Wangsa Maju &lt;-&gt; Setapak Sentral) modelled as an undirected weighted graph with DFS/BFS traversal and a JavaFX visualisation.</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>
        <javafx.version>21.0.9</javafx.version>
        <!-- Default platform classifier; overridden by the OS profiles below. -->
        <javafx.platform>win</javafx.platform>
    </properties>

    <!-- JavaFX jars on Maven Central are platform-specific, so the right
         classifier (win / mac / linux) is picked from the current OS. -->
    <profiles>
        <profile>
            <id>windows</id>
            <activation>
                <os><family>windows</family></os>
            </activation>
            <properties><javafx.platform>win</javafx.platform></properties>
        </profile>
        <profile>
            <id>mac</id>
            <activation>
                <os><family>mac</family></os>
            </activation>
            <properties><javafx.platform>mac</javafx.platform></properties>
        </profile>
        <profile>
            <id>linux</id>
            <activation>
                <os><family>linux</family></os>
            </activation>
            <properties><javafx.platform>linux</javafx.platform></properties>
        </profile>
    </profiles>

    <dependencies>
        <!-- javafx-controls pulls in javafx-graphics and javafx-base. -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
            <classifier>${javafx.platform}</classifier>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- "mvn javafx:run" (and the Run button in NetBeans) launches the
                 application with the JavaFX modules on the module path. -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>com.rapidkl.t250.Main</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
